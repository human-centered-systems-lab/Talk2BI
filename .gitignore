# The evaluation directory holds source alongside generated experiment data.
# Ignore its contents rather than the directory itself -- git never descends
# into an excluded directory, so the negation below only works this way.
src/evaluation/knowledge-catalog/evaluation/*
!src/evaluation/knowledge-catalog/evaluation/*.py

