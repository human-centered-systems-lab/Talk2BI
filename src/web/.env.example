# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# OpenAI Compatible
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://ki-toolbox.scc.kit.edu/api
OPENAI_MODEL=kit.gpt-oss-120b
EMBEDDING_MODEL=kit.qwen3-embedding-8b

# Neo4j connection settings (for setup_initial_graph.py)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Snowflake connection settings
SNOWFLAKE_ACCOUNT=RSR...
SNOWFLAKE_USER=NW_...
SNOWFLAKE_PERSONALACCESSTOKEN=...
SNOWFLAKE_WAREHOUSE=COMPUTE_...

# Databricks credentials
# DATABRICKS_CATALOG and DATABRICKS_SCHEMA are the defaults for unqualified
# queries; imported tables are always addressed fully qualified.
DATABRICKS_HOST=adb-....azuredatabricks.net
DATABRICKS_TOKEN=dapi...
DATABRICKS_WAREHOUSE_ID=...

# Optional: overrides the /sql/1.0/warehouses/<id> path, e.g. for an
# all-purpose compute cluster.
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/...
